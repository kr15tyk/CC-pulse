          "title": "Clarification Regarding Optional Selections Required by RFC8446",
          "protection_profile": [
            {
              "pp_id": 519,
              "pp_name": "Functional Package for Transport Layer Security (TLS) Version 2.1",
              "pp_common_name": "Functional Package for Transport Layer Security (TLS) Version 2.1",
              "cc_version": "CC:2022",
              "mr_version": null,
              "pp_date": "2025-09-03T00:00:00Z",
              "entrydate": "2025-09-03T12:25:21.558000Z",
              "tech_type": "Network Encryption",
              "pp_sponsor_id": "NIAP",
              "community_id": null,
              "status": "Publishing",
              "sunset_date": null,
              "pp_overview": "<p style=\"margin-top: 0in; background: white; margin-right: 0in; margin-left: 0in; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span style=\"font-family: Arial, sans-serif; color: #212529;\">Transport Layer Security (TLS) and the closely-related Datagram TLS (DTLS) are cryptographic protocols designed to provide communications security over IP networks.&nbsp;The primary goal of the TLS protocol is to provide confidentiality and integrity of data transmitted between two communicating endpoints, as well as authentication of at least the server endpoint.</span></p>\r\n<p style=\"margin-top: 0in; background: rgb(255, 255, 253); margin-right: 0in; margin-left: 0in; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span style=\"font-family: Arial, sans-serif; color: #000006;\">This \"Functional Package for Transport Layer Security\" (short name \"TLS-PKG\") defines functional requirements for the implementation of the Transport Layer Security (TLS) and Datagram TLS (DTLS) protocols.&nbsp;The requirements are intended to improve the security of products by enabling their evaluation.</span></p>",
              "security_evaluation_summary": "<p style=\"margin-top: 0in; background: white; margin-right: 0in; margin-left: 0in; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span style=\"font-family: Arial, sans-serif; color: #212529;\">The Target of Evaluation (TOE) in this Package is a product which acts as a TLS client or server, or both.&nbsp;This Package describes the security functionality of TLS in terms of CC.</span></p>\r\n<p style=\"margin: 0in 0in 1rem; background: white; box-sizing: border-box; font-variant-ligatures: normal; text-align: start; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; font-size: 12pt; font-family: 'Times New Roman', serif;\"><span style=\"font-family: Arial, sans-serif; color: #212529;\">The contents of this Package must be appropriately combined with a PP or PP-Module. When this Package is instantiated by a PP or PP-Module, the Package must include selection-based requirements in accordance with the selections or assignments indicated in the PP or PP-Module.</span></p>",
              "environmental_strengths": "",
              "pp_priority": null,
              "created_on": null,
              "removed_on": null,
              "archived": false,
              "assurance_maintenance": null,
